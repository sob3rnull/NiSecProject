# local.rules — custom Suricata signatures for the NISec lab.
# SIDs use the local range 9000000+ to avoid clashing with ET Open.
# Reload after changes: sudo suricata-update && sudo systemctl restart suricata
#
# DEPENDENCY — every rule below is written `$EXTERNAL_NET -> $HOME_NET`, and
# suricata.yaml defines EXTERNAL_NET as "!$HOME_NET". So these rules only fire
# while the attacker (Kali, 192.168.56.10) is OUTSIDE HOME_NET. provision/
# monitored-server.sh sets HOME_NET to the protected hosts only for exactly
# this reason — widening it back to 192.168.56.0/24 silently kills all three.

# --- ICMP ping flood (DoS demo — hping3 --icmp --flood) ----------------
# The stock ruleset often won't flag a plain ICMP flood, so we add a
# threshold: more than 500 ICMP echo requests to one host in 10s = alert.
alert icmp $EXTERNAL_NET any -> $HOME_NET any ( \
    msg:"NISEC ICMP ping flood detected (possible DoS)"; \
    itype:8; \
    threshold:type both, track by_dst, count 500, seconds 10; \
    classtype:denial-of-service; sid:9000001; rev:1; )

# --- Nmap SYN scan (reconnaissance) ------------------------------------
# Many SYNs to different ports from one source in a short window.
alert tcp $EXTERNAL_NET any -> $HOME_NET any ( \
    msg:"NISEC possible TCP SYN port scan (reconnaissance)"; \
    flags:S; \
    threshold:type both, track by_src, count 30, seconds 5; \
    classtype:attempted-recon; sid:9000002; rev:1; )

# --- SSH brute-force at the network layer (backs up Wazuh host rule) ---
alert tcp $EXTERNAL_NET any -> $HOME_NET 22 ( \
    msg:"NISEC repeated SSH connections (possible brute-force)"; \
    flow:to_server; flags:S; \
    threshold:type both, track by_src, count 20, seconds 30; \
    classtype:attempted-admin; sid:9000003; rev:1; )
