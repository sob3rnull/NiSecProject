# Copy to .env and set REAL passwords, or run ./up.sh which generates
# strong random ones for you. NEVER commit the real .env (it is gitignored).
#
# The compose file has NO default fallbacks by design: if these are unset or
# left as the placeholder below, the stack refuses to start. That is
# deliberate — a security monitoring system booting on publicly-known
# credentials would undermine the very thing this project is demonstrating.
INDEXER_PASSWORD=CHANGE_ME
API_PASSWORD=CHANGE_ME
